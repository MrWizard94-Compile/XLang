{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/schemas/aether-ast-v4.schema.json",
  "title": "Aether semantic AST v4",
  "description": "Canonical, local machine-readable Aether 0.9 semantic structure. Version 4 adds shape declarations and dual-layout table expressions while retaining prior node definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "language", "canonicalSource", "program"],
  "properties": {
    "schema": { "const": "aether.ast/v4" },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "Aether" }, "version": { "type": "string" } }
    },
    "canonicalSource": { "type": "string", "maxLength": 1000000 },
    "program": { "$ref": "#/$defs/program" }
  },
  "$defs": {
    "id": { "$ref": "aether-ast-v1.schema.json#/$defs/id" },
    "span": { "$ref": "aether-ast-v1.schema.json#/$defs/span" },
    "valueType": { "$ref": "aether-ast-v1.schema.json#/$defs/valueType" },
    "atom": { "$ref": "aether-ast-v1.schema.json#/$defs/atom" },
    "world": { "$ref": "aether-ast-v1.schema.json#/$defs/world" },
    "record": { "$ref": "aether-ast-v1.schema.json#/$defs/record" },
    "parameter": { "$ref": "aether-ast-v1.schema.json#/$defs/parameter" },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "world", "records", "shapes", "weaves"],
      "properties": {
        "id": { "const": "program" },
        "kind": { "const": "Program" },
        "world": { "$ref": "#/$defs/world" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "shapes": { "type": "array", "items": { "$ref": "#/$defs/shape" } },
        "weaves": { "type": "array", "items": { "$ref": "#/$defs/weave" } }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "Shape" },
        "span": { "$ref": "#/$defs/span" },
        "name": { "type": "string" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/shapeField" }
        }
      }
    },
    "shapeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "ShapeField" },
        "span": { "$ref": "#/$defs/span" },
        "name": { "type": "string" },
        "type": { "const": "Whole" }
      }
    },
    "weave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "parameters", "result", "effect", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "Weave" },
        "span": { "$ref": "#/$defs/span" },
        "name": { "type": "string" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "result": { "$ref": "#/$defs/valueType" },
        "effect": { "enum": ["Total", "ErrorWhole"] },
        "body": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
      }
    },
    "statement": {
      "oneOf": [
        { "$ref": "#/$defs/bind" }, { "$ref": "#/$defs/revise" }, { "$ref": "#/$defs/speak" },
        { "$ref": "#/$defs/yield" }, { "$ref": "#/$defs/raise" }, { "$ref": "#/$defs/forward" },
        { "$ref": "#/$defs/handle" }, { "$ref": "#/$defs/choose" }, { "$ref": "#/$defs/while" }
      ]
    },
    "bind": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "mutable", "stage", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Bind" }, "span": { "$ref": "#/$defs/span" },
        "name": { "type": "string" }, "mutable": { "type": "boolean" },
        "stage": { "enum": ["runtime", "comptime"] }, "value": { "$ref": "#/$defs/expression" }
      }
    },
    "revise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Revise" }, "span": { "$ref": "#/$defs/span" }, "name": { "type": "string" }, "value": { "$ref": "#/$defs/expression" } }
    },
    "speak": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Speak" }, "span": { "$ref": "#/$defs/span" }, "value": { "$ref": "#/$defs/expression" } }
    },
    "yield": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Yield" }, "span": { "$ref": "#/$defs/span" }, "value": { "$ref": "#/$defs/expression" } }
    },
    "raise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "code"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Raise" }, "span": { "$ref": "#/$defs/span" }, "code": { "$ref": "#/$defs/atom" } }
    },
    "forward": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "weave", "arguments"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Forward" }, "span": { "$ref": "#/$defs/span" }, "weave": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "#/$defs/atom" } } }
    },
    "handle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "weave", "arguments", "successDestination", "errorDestination"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Handle" }, "span": { "$ref": "#/$defs/span" },
        "weave": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "#/$defs/atom" } },
        "successDestination": { "type": "string" }, "errorDestination": { "type": "string" }
      }
    },
    "choose": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "condition", "whenBright", "whenDim"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Choose" }, "span": { "$ref": "#/$defs/span" },
        "condition": { "$ref": "#/$defs/expression" },
        "whenBright": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
        "whenDim": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
      }
    },
    "while": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "condition", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "While" }, "span": { "$ref": "#/$defs/span" },
        "condition": { "$ref": "#/$defs/expression" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "span"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "editableDeclaration": {
      "oneOf": [
        { "$ref": "#/$defs/record" },
        { "$ref": "#/$defs/shape" },
        { "$ref": "#/$defs/weave" }
      ]
    }
  }
}

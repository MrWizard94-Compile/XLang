{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/schemas/aether-ast-v3.schema.json",
  "title": "Aether semantic AST v3",
  "description": "Canonical, local machine-readable Aether 0.8 semantic structure. Version 3 adds explicit runtime or bounded comptime provenance to every binding while retaining v1 definitions for unchanged nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "language", "canonicalSource", "program"],
  "properties": {
    "schema": { "const": "aether.ast/v3" },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "Aether" }, "version": { "type": "string" } }
    },
    "canonicalSource": { "type": "string", "maxLength": 1000000 },
    "program": { "$ref": "#/$defs/program" }
  },
  "$defs": {
    "id": { "$ref": "aether-ast-v1.schema.json#/$defs/id" },
    "span": { "$ref": "aether-ast-v1.schema.json#/$defs/span" },
    "valueType": { "$ref": "aether-ast-v1.schema.json#/$defs/valueType" },
    "atom": { "$ref": "aether-ast-v1.schema.json#/$defs/atom" },
    "expression": { "$ref": "aether-ast-v1.schema.json#/$defs/expression" },
    "world": { "$ref": "aether-ast-v1.schema.json#/$defs/world" },
    "record": { "$ref": "aether-ast-v1.schema.json#/$defs/record" },
    "parameter": { "$ref": "aether-ast-v1.schema.json#/$defs/parameter" },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "world", "records", "weaves"],
      "properties": {
        "id": { "const": "program" },
        "kind": { "const": "Program" },
        "world": { "$ref": "#/$defs/world" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "weaves": { "type": "array", "items": { "$ref": "#/$defs/weave" } }
      }
    },
    "weave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "parameters", "result", "effect", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "Weave" },
        "span": { "$ref": "#/$defs/span" },
        "name": { "type": "string" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "result": { "$ref": "#/$defs/valueType" },
        "effect": { "enum": ["Total", "ErrorWhole"] },
        "body": { "type": "array", "items": { "$ref": "#/$defs/statement" } }
      }
    },
    "statement": {
      "oneOf": [
        { "$ref": "#/$defs/bind" }, { "$ref": "#/$defs/revise" }, { "$ref": "#/$defs/speak" },
        { "$ref": "#/$defs/yield" }, { "$ref": "#/$defs/raise" }, { "$ref": "#/$defs/forward" },
        { "$ref": "#/$defs/handle" }, { "$ref": "#/$defs/choose" }, { "$ref": "#/$defs/while" }
      ]
    },
    "bind": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "mutable", "stage", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Bind" }, "span": { "$ref": "#/$defs/span" }, "name": { "type": "string" }, "mutable": { "type": "boolean" }, "stage": { "enum": ["runtime", "comptime"] }, "value": { "$ref": "#/$defs/expression" } }
    },
    "revise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "name", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Revise" }, "span": { "$ref": "#/$defs/span" }, "name": { "type": "string" }, "value": { "$ref": "#/$defs/expression" } }
    },
    "speak": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Speak" }, "span": { "$ref": "#/$defs/span" }, "value": { "$ref": "#/$defs/expression" } }
    },
    "yield": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Yield" }, "span": { "$ref": "#/$defs/span" }, "value": { "$ref": "#/$defs/expression" } }
    },
    "raise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "code"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Raise" }, "span": { "$ref": "#/$defs/span" }, "code": { "$ref": "#/$defs/atom" } }
    },
    "forward": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "weave", "arguments"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Forward" }, "span": { "$ref": "#/$defs/span" }, "weave": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "#/$defs/atom" } } }
    },
    "handle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "weave", "arguments", "successDestination", "errorDestination"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Handle" }, "span": { "$ref": "#/$defs/span" }, "weave": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "#/$defs/atom" } }, "successDestination": { "type": "string" }, "errorDestination": { "type": "string" } }
    },
    "choose": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "condition", "whenBright", "whenDim"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "Choose" }, "span": { "$ref": "#/$defs/span" }, "condition": { "$ref": "#/$defs/expression" }, "whenBright": { "type": "array", "items": { "$ref": "#/$defs/statement" } }, "whenDim": { "type": "array", "items": { "$ref": "#/$defs/statement" } } }
    },
    "while": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "span", "condition", "body"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "While" }, "span": { "$ref": "#/$defs/span" }, "condition": { "$ref": "#/$defs/expression" }, "body": { "type": "array", "items": { "$ref": "#/$defs/statement" } } }
    },
    "editableDeclaration": { "oneOf": [ { "$ref": "aether-ast-v1.schema.json#/$defs/editableRecord" }, { "$ref": "#/$defs/editableWeave" } ] },
    "editableWeave": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "parameters", "result", "effect", "body"],
      "properties": { "kind": { "const": "Weave" }, "name": { "type": "string" }, "parameters": { "type": "array", "items": { "$ref": "aether-ast-v1.schema.json#/$defs/editableParameter" } }, "result": { "$ref": "#/$defs/valueType" }, "effect": { "enum": ["Total", "ErrorWhole"] }, "body": { "type": "array", "items": { "$ref": "#/$defs/editableStatement" } } }
    },
    "editableStatement": {
      "oneOf": [
        { "$ref": "#/$defs/editableBind" }, { "$ref": "#/$defs/editableRevise" }, { "$ref": "#/$defs/editableSpeak" },
        { "$ref": "#/$defs/editableYield" }, { "$ref": "#/$defs/editableRaise" }, { "$ref": "#/$defs/editableForward" },
        { "$ref": "#/$defs/editableHandle" }, { "$ref": "#/$defs/editableChoose" }, { "$ref": "#/$defs/editableWhile" }
      ]
    },
    "editableBind": { "type": "object", "additionalProperties": false, "required": ["kind", "name", "mutable", "stage", "value"], "properties": { "kind": { "const": "Bind" }, "name": { "type": "string" }, "mutable": { "type": "boolean" }, "stage": { "enum": ["runtime", "comptime"] }, "value": { "$ref": "aether-ast-v1.schema.json#/$defs/editableExpression" } } },
    "editableRevise": { "type": "object", "additionalProperties": false, "required": ["kind", "name", "value"], "properties": { "kind": { "const": "Revise" }, "name": { "type": "string" }, "value": { "$ref": "aether-ast-v1.schema.json#/$defs/editableExpression" } } },
    "editableSpeak": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "Speak" }, "value": { "$ref": "aether-ast-v1.schema.json#/$defs/editableExpression" } } },
    "editableYield": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "Yield" }, "value": { "$ref": "aether-ast-v1.schema.json#/$defs/editableExpression" } } },
    "editableRaise": { "type": "object", "additionalProperties": false, "required": ["kind", "code"], "properties": { "kind": { "const": "Raise" }, "code": { "$ref": "aether-ast-v1.schema.json#/$defs/editableAtom" } } },
    "editableForward": { "type": "object", "additionalProperties": false, "required": ["kind", "weave", "arguments"], "properties": { "kind": { "const": "Forward" }, "weave": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "aether-ast-v1.schema.json#/$defs/editableAtom" } } } },
    "editableHandle": { "type": "object", "additionalProperties": false, "required": ["kind", "weave", "arguments", "successDestination", "errorDestination"], "properties": { "kind": { "const": "Handle" }, "weave": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "aether-ast-v1.schema.json#/$defs/editableAtom" } }, "successDestination": { "type": "string" }, "errorDestination": { "type": "string" } } },
    "editableChoose": { "type": "object", "additionalProperties": false, "required": ["kind", "condition", "whenBright", "whenDim"], "properties": { "kind": { "const": "Choose" }, "condition": { "$ref": "aether-ast-v1.schema.json#/$defs/editableExpression" }, "whenBright": { "type": "array", "items": { "$ref": "#/$defs/editableStatement" } }, "whenDim": { "type": "array", "items": { "$ref": "#/$defs/editableStatement" } } } },
    "editableWhile": { "type": "object", "additionalProperties": false, "required": ["kind", "condition", "body"], "properties": { "kind": { "const": "While" }, "condition": { "$ref": "aether-ast-v1.schema.json#/$defs/editableExpression" }, "body": { "type": "array", "items": { "$ref": "#/$defs/editableStatement" } } } }
  }
}

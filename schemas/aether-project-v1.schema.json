{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/schemas/aether-project-v1.schema.json",
  "title": "Aether project document v1",
  "description": "Offline local project metadata with optional SHA-256 unit locks. Nested relative unit paths use forward slashes only (M10). Units are independent complete programs; no language modules or network dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "units"],
  "properties": {
    "schema": { "const": "aether.project/v1" },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": { "type": "string", "minLength": 1 },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/unit" }
    },
    "lock": { "$ref": "#/$defs/lock" }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path with '/' separators only; each segment is [A-Za-z0-9._-]+ excluding '.' and '..'; ends with .ae",
          "pattern": "^(?:[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)(?:/(?:[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*))*\\.ae$"
        },
        "role": { "enum": ["main", "lib"] }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}

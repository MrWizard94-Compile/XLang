weave bundle_world [borrow value: Text] -> Text:
  bind mutable output <- "!"
  bind mutable length <- measure borrow value
  bind mutable line_end <- seek borrow value "\n" 0
  bind mutable prefix <- "world "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable prefix_at <- -1
  bind mutable valid <- dim
  choose less -1 line_end:
    revise prefix_at <- seek borrow value borrow prefix 0
    choose same prefix_at 0:
      choose less prefix_length line_end:
        revise output <- cut borrow value prefix_length line_end
        revise valid <- call bundle_safe_identifier borrow output
      otherwise:
        revise valid <- dim
    otherwise:
      revise valid <- dim
  otherwise:
    revise valid <- dim
  choose valid:
    revise output <- borrow output
  otherwise:
    revise output <- "!"
  yield move output

weave bundle_mangle [borrow path: Text, borrow name: Text] -> Text:
  bind mutable output <- "m_"
  bind mutable length <- measure borrow path
  bind mutable stem_end <- difference length 3
  bind mutable cursor <- 0
  bind mutable next <- 0
  bind mutable code <- 0
  bind mutable character <- ""
  while less cursor stem_end:
    revise next <- sum cursor 1
    revise code <- glyph borrow path cursor
    choose same code 47:
      revise output <- join borrow output "_"
    otherwise:
      revise character <- cut borrow path cursor next
      revise output <- join borrow output borrow character
    revise cursor <- next
  revise output <- join borrow output "_"
  revise output <- join borrow output borrow name
  yield move output

weave bundle_pure_whole_source [borrow value: Text] -> Truth:
  bind mutable forbidden <- seek borrow value "arena " 0
  bind mutable permitted <- dim
  choose same forbidden -1:
    revise forbidden <- seek borrow value "buffer " 0
    choose same forbidden -1:
      revise forbidden <- seek borrow value "allocate " 0
      choose same forbidden -1:
        revise forbidden <- seek borrow value "release " 0
        choose same forbidden -1:
          revise forbidden <- seek borrow value "access " 0
          choose same forbidden -1:
            revise forbidden <- seek borrow value "handle " 0
            choose same forbidden -1:
              revise forbidden <- seek borrow value "raise " 0
              choose same forbidden -1:
                revise forbidden <- seek borrow value "forward " 0
                choose same forbidden -1:
                  revise forbidden <- seek borrow value "spawn " 0
                  choose same forbidden -1:
                    revise forbidden <- seek borrow value "together" 0
                  otherwise:
                    revise forbidden <- forbidden
                otherwise:
                  revise forbidden <- forbidden
              otherwise:
                revise forbidden <- forbidden
            otherwise:
              revise forbidden <- forbidden
          otherwise:
            revise forbidden <- forbidden
        otherwise:
          revise forbidden <- forbidden
      otherwise:
        revise forbidden <- forbidden
    otherwise:
      revise forbidden <- forbidden
  otherwise:
    revise forbidden <- forbidden
  choose same forbidden -1:
    revise permitted <- bright
  otherwise:
    revise permitted <- dim
  yield permitted

weave bundle_rewrite_calls [borrow value: Text, borrow alias: Text, borrow helper: Text, borrow mangled: Text] -> Text:
  bind mutable output <- ""
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable found <- -1
  bind mutable target_start <- 0
  bind mutable target_end <- 0
  bind mutable space_at <- -1
  bind mutable newline_at <- -1
  bind mutable prefix <- ""
  bind mutable target <- ""
  bind mutable call_prefix <- "call "
  bind mutable call_length <- measure borrow call_prefix
  bind mutable failed <- dim
  bind mutable saw_call <- dim
  while less cursor length:
    revise found <- seek borrow value borrow call_prefix cursor
    choose same found -1:
      revise prefix <- cut borrow value cursor length
      revise output <- join borrow output borrow prefix
      revise cursor <- length
    otherwise:
      revise prefix <- cut borrow value cursor found
      revise output <- join borrow output borrow prefix
      revise target_start <- sum found call_length
      revise space_at <- seek borrow value " " target_start
      revise newline_at <- seek borrow value "\n" target_start
      choose same space_at -1:
        choose same newline_at -1:
          revise target_end <- length
        otherwise:
          revise target_end <- newline_at
      otherwise:
        choose same newline_at -1:
          revise target_end <- space_at
        otherwise:
          choose less space_at newline_at:
            revise target_end <- space_at
          otherwise:
            revise target_end <- newline_at
      revise target <- cut borrow value target_start target_end
      revise prefix <- join borrow alias "."
      revise prefix <- join borrow prefix borrow helper
      choose same borrow target borrow prefix:
        revise output <- join borrow output borrow call_prefix
        revise output <- join borrow output borrow mangled
        revise cursor <- target_end
        revise saw_call <- bright
      otherwise:
        revise failed <- bright
        revise cursor <- length
  choose failed:
    revise output <- "!"
  otherwise:
    choose saw_call:
      revise output <- borrow output
    otherwise:
      revise output <- "!"
  yield move output


  while less cursor length:
    revise line_end <- seek borrow source "\n" cursor
    choose same line_end -1:
      revise line_end <- length
      revise next <- length
    otherwise:
      revise next <- sum line_end 1
    revise line <- cut borrow source cursor line_end
    revise line_length <- measure borrow line
    choose less 0 line_length:
      revise last <- difference line_length 1
      revise code <- glyph borrow line last
      choose same code 13:
        revise line <- cut borrow line 0 last
      otherwise:
        revise line <- borrow line
    otherwise:
      revise line <- borrow line
    revise line_length <- measure borrow line
    choose less 0 line_length:
      choose wrote:
        revise output <- join borrow output "\n"
      otherwise:
        revise output <- borrow output
      revise output <- join borrow output borrow line
      revise wrote <- bright
    otherwise:
      revise output <- borrow output
    revise cursor <- next
  yield move output


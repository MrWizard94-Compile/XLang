weave bundle_world [borrow value: Text] -> Text:
  bind mutable output <- "!"
  bind mutable length <- measure borrow value
  bind mutable line_end <- seek borrow value "\n" 0
  bind mutable prefix <- "world "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable prefix_at <- -1
  bind mutable valid <- dim
  choose less -1 line_end:
    revise prefix_at <- seek borrow value borrow prefix 0
    choose same prefix_at 0:
      choose less prefix_length line_end:
        revise output <- cut borrow value prefix_length line_end
        revise valid <- call bundle_safe_identifier borrow output
      otherwise:
        revise valid <- dim

              revise valid <- dim
          otherwise:
            revise valid <- dim
        otherwise:
          revise valid <- dim
      otherwise:
        revise valid <- dim
    otherwise:
      revise valid <- dim
  otherwise:
    revise valid <- dim
  choose valid:
    revise left_pure <- call bundle_pure_whole_source borrow left_source
    revise right_pure <- call bundle_pure_whole_source borrow right_source
    revise merge_pure <- call bundle_pure_whole_source borrow merge_source
    revise entry_pure <- call bundle_pure_whole_source borrow entry_source
    choose left_pure:
      choose right_pure:
        choose merge_pure:
          choose entry_pure:
            revise valid <- bright
          otherwise:
            revise valid <- dim
        otherwise:
          revise valid <- dim
      otherwise:
        revise valid <- dim
    otherwise:
      revise valid <- dim
  otherwise:
    revise valid <- dim
  choose valid:
    revise left_mangled <- call bundle_mangle borrow left_path borrow left_helper
    revise right_mangled <- call bundle_mangle borrow right_path borrow right_helper
    revise merge_mangled <- call bundle_mangle borrow merge_path borrow merge_helper
    revise left_helper_length <- measure borrow left_helper
    revise right_helper_length <- measure borrow right_helper
    revise merge_helper_length <- measure borrow merge_helper
    revise left_tail_start <- sum left_export_start export_prefix_length
    revise left_tail_start <- sum left_tail_start left_helper_length
    revise left_tail <- cut borrow left_source left_tail_start left_length
    revise right_tail_start <- sum right_export_start export_prefix_length
    revise right_tail_start <- sum right_tail_start right_helper_length
    revise right_tail <- cut borrow right_source right_tail_start right_length
    revise merge_tail_start <- sum merge_export_start export_prefix_length
    revise merge_tail_start <- sum merge_tail_start merge_helper_length
    revise merge_tail <- cut borrow merge_source merge_tail_start merge_length
    revise rewritten_merge <- call bundle_rewrite_two_calls borrow merge_tail borrow first_alias borrow left_helper borrow left_mangled borrow second_alias borrow right_helper borrow right_mangled
    revise after_import <- sum entry_import_line_end 1
    revise rewritten_entry <- cut borrow entry_source after_import entry_length
    revise rewritten_entry <- call bundle_rewrite_calls borrow rewritten_entry borrow entry_alias borrow merge_helper borrow merge_mangled
    choose same borrow rewritten_merge "!":
      revise valid <- dim
    otherwise:
      choose same borrow rewritten_entry "!":
        revise valid <- dim
      otherwise:
        revise valid <- bright
  otherwise:
    revise valid <- dim
  choose valid:
    revise combined <- "world "
    revise combined <- join borrow combined borrow entry_world
    revise combined <- join borrow combined "\n\n"
    revise combined <- join borrow combined "weave "
    revise combined <- join borrow combined borrow left_mangled
    revise combined <- join borrow combined borrow left_tail
    revise combined <- join borrow combined "\n"
    revise combined <- join borrow combined "weave "
    revise combined <- join borrow combined borrow right_mangled
    revise combined <- join borrow combined borrow right_tail
    revise combined <- join borrow combined "\n"
    revise combined <- join borrow combined "weave "
    revise combined <- join borrow combined borrow merge_mangled
    revise combined <- join borrow combined borrow rewritten_merge
    revise combined <- join borrow combined "\n"
    revise combined <- join borrow combined borrow rewritten_entry
    revise output <- borrow combined
  otherwise:
    revise output <- "!"
  yield move output

weave modules_trim_start [borrow value: Text] -> Text:
  bind mutable output <- ""
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable start <- 0
  bind mutable code <- 0
  bind mutable done <- dim
  while less cursor length:
    choose done:
      revise cursor <- length
    otherwise:
      revise code <- glyph borrow value cursor
      choose same code 32:
        revise cursor <- sum cursor 1
      otherwise:
        choose same code 9:
          revise cursor <- sum cursor 1
        otherwise:
          choose same code 13:
            revise cursor <- sum cursor 1
          otherwise:
            revise code <- code
            revise start <- cursor
            revise done <- bright
            revise cursor <- length
    choose done:
      revise output <- cut borrow value start length
    otherwise:
      revise output <- borrow output
  yield move output

weave modules_trim_end [borrow value: Text] -> Text:
  bind mutable output <- ""
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable code <- 0
  bind mutable last <- 0
  bind mutable saw <- dim
  while less cursor length:
    revise code <- glyph borrow value cursor
    choose same code 32:
      revise last <- last
    otherwise:
      choose same code 9:
        revise last <- last
      otherwise:
        choose same code 10:
          revise last <- last
        otherwise:
          choose same code 13:
            revise last <- last
          otherwise:
            revise last <- sum cursor 1
            revise saw <- bright
    revise cursor <- sum cursor 1
  choose saw:
    revise output <- cut borrow value 0 last
  otherwise:
    revise output <- ""
  yield move output

weave modules_replace_all [borrow value: Text, borrow from: Text, borrow to: Text] -> Text:
  bind mutable output <- ""
  bind mutable length <- measure borrow value
  bind mutable from_length <- measure borrow from
  bind mutable cursor <- 0
  bind mutable found <- -1
  bind mutable prefix <- ""
  bind mutable valid <- bright
  choose same from_length 0:
    revise valid <- dim
  otherwise:
    revise valid <- valid
  while less cursor length:
    choose valid:
      revise found <- seek borrow value borrow from cursor
      choose same found -1:
        revise prefix <- cut borrow value cursor length
        revise output <- join borrow output borrow prefix
        revise cursor <- length
      otherwise:
        revise prefix <- cut borrow value cursor found
        revise output <- join borrow output borrow prefix
        revise output <- join borrow output borrow to
        revise cursor <- sum found from_length
    otherwise:
      revise cursor <- length
  choose valid:
    revise output <- borrow output
  otherwise:
    revise output <- "!"
  yield move output

weave modules_set_contains [borrow values: Text, borrow value: Text] -> Truth:
  bind mutable pattern <- "|"
  bind mutable found <- -1
  bind mutable result <- dim
  revise pattern <- join borrow pattern borrow value
  revise pattern <- join borrow pattern "|"
  revise found <- seek borrow values borrow pattern 0
  choose same found -1:
    revise result <- dim
  otherwise:
    revise result <- bright
  yield result

weave modules_set_add [borrow values: Text, borrow value: Text] -> Text:
  bind mutable output <- ""
  bind mutable pattern <- "|"
  bind mutable length <- measure borrow values
  bind mutable present <- call modules_set_contains borrow values borrow value
  choose present:
    revise output <- borrow values
  otherwise:
    choose same length 0:
      revise output <- "|"
    otherwise:
      revise output <- borrow values
    revise output <- join borrow output borrow value
    revise output <- join borrow output "|"
  yield move output

weave modules_set_remove [borrow values: Text, borrow value: Text] -> Text:
  bind mutable pattern <- "|"
  bind mutable output <- ""
  bind mutable output_length <- 0
  revise pattern <- join borrow pattern borrow value
  revise pattern <- join borrow pattern "|"
  revise output <- call modules_replace_all borrow values borrow pattern "|"
  revise output_length <- measure borrow output
  choose same output_length 1:
    choose same borrow output "|":
      revise output <- ""
    otherwise:
      revise output <- borrow output
  otherwise:
    revise output <- borrow output
  yield move output

weave modules_set_last [borrow values: Text] -> Text:
  bind mutable output <- "!"
  bind mutable length <- measure borrow values
  bind mutable cursor <- 0
  bind mutable code <- 0
  bind mutable previous_delimiter <- -1
  bind mutable last_delimiter <- -1
  bind mutable start <- 0
  bind mutable expected_last <- 0
  while less cursor length:
    revise code <- glyph borrow values cursor
    choose same code 124:
      revise previous_delimiter <- last_delimiter
      revise last_delimiter <- cursor
    otherwise:
      revise code <- code
    revise cursor <- sum cursor 1
  choose less -1 previous_delimiter:
    revise start <- sum previous_delimiter 1
    revise expected_last <- difference length 1
    choose same last_delimiter expected_last:
      revise output <- cut borrow values start last_delimiter
    otherwise:
      revise output <- "!"
  otherwise:
    revise output <- "!"
  yield move output

weave modules_set_count [borrow values: Text] -> Whole:
  bind mutable count <- 0
  bind mutable length <- measure borrow values
  bind mutable cursor <- 0
  bind mutable code <- 0
  while less cursor length:
    revise code <- glyph borrow values cursor
    choose same code 124:
      revise count <- sum count 1
    otherwise:
      revise code <- code
    revise cursor <- sum cursor 1
  choose less 0 count:
    revise count <- difference count 1
  otherwise:
    revise count <- 0
  yield count

weave modules_set_nth [borrow values: Text, index: Whole] -> Text:
  bind mutable output <- "!"
  bind mutable length <- measure borrow values
  bind mutable cursor <- 0
  bind mutable start <- 0
  bind mutable current <- 0
  bind mutable code <- 0
  bind mutable found <- dim
  while less cursor length:
    revise code <- glyph borrow values cursor
    choose same code 124:
      choose less 0 cursor:
        choose same current index:
          choose found:
            revise found <- found
          otherwise:
            revise output <- cut borrow values start cursor
            revise found <- bright
        otherwise:
          revise current <- current
        revise current <- sum current 1
      otherwise:
        revise start <- sum cursor 1
      revise start <- sum cursor 1
    otherwise:
      revise code <- code
    revise cursor <- sum cursor 1
  yield move output

weave modules_lower_ascii_character [borrow value: Text] -> Text:
  bind mutable output <- borrow value
  bind mutable code <- glyph borrow value 0
  choose same code 65:
    revise output <- "a"
  otherwise:
    choose same code 66:
      revise output <- "b"
    otherwise:
      choose same code 67:
        revise output <- "c"
      otherwise:
        choose same code 68:
          revise output <- "d"
        otherwise:
          choose same code 69:
            revise output <- "e"
          otherwise:
            choose same code 70:
              revise output <- "f"
            otherwise:
              choose same code 71:
                revise output <- "g"
              otherwise:
                choose same code 72:
                  revise output <- "h"
                otherwise:
                  choose same code 73:
                    revise output <- "i"
                  otherwise:
                    choose same code 74:
                      revise output <- "j"
                    otherwise:
                      choose same code 75:
                        revise output <- "k"
                      otherwise:
                        choose same code 76:
                          revise output <- "l"
                        otherwise:
                          choose same code 77:
                            revise output <- "m"
                          otherwise:
                            choose same code 78:
                              revise output <- "n"
                            otherwise:
                              choose same code 79:
                                revise output <- "o"
                              otherwise:
                                choose same code 80:
                                  revise output <- "p"
                                otherwise:
                                  choose same code 81:
                                    revise output <- "q"
                                  otherwise:
                                    choose same code 82:
                                      revise output <- "r"
                                    otherwise:
                                      choose same code 83:
                                        revise output <- "s"
                                      otherwise:
                                        choose same code 84:
                                          revise output <- "t"
                                        otherwise:
                                          choose same code 85:
                                            revise output <- "u"
                                          otherwise:
                                            choose same code 86:
                                              revise output <- "v"
                                            otherwise:
                                              choose same code 87:
                                                revise output <- "w"
                                              otherwise:
                                                choose same code 88:
                                                  revise output <- "x"
                                                otherwise:
                                                  choose same code 89:
                                                    revise output <- "y"
                                                  otherwise:
                                                    choose same code 90:
                                                      revise output <- "z"
                                                    otherwise:
                                                      revise output <- borrow value
  yield move output

weave modules_mangle [borrow key: Text, borrow name: Text] -> Text:
  bind mutable output <- "m_"
  bind mutable length <- measure borrow key
  bind mutable stem_end <- difference length 3
  bind mutable cursor <- 0
  bind mutable next <- 0
  bind mutable code <- 0
  bind mutable character <- ""
  bind mutable lowered <- ""
  while less cursor stem_end:
    revise next <- sum cursor 1
    revise code <- glyph borrow key cursor
    choose same code 47:
      revise output <- join borrow output "_"
    otherwise:
      choose same code 58:
        revise output <- join borrow output "_"
      otherwise:
        choose same code 46:
          revise output <- join borrow output "_"
        otherwise:
          revise character <- cut borrow key cursor next
          revise lowered <- call modules_lower_ascii_character borrow character
          revise output <- join borrow output borrow lowered
    revise cursor <- next
  revise output <- join borrow output "_"
  revise output <- join borrow output borrow name
  yield move output

weave modules_safe_package [borrow value: Text] -> Truth:
  bind mutable result <- bright
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable code <- 0
  choose same length 0:
    revise result <- dim
  otherwise:
    revise result <- result
  while less cursor length:
    revise code <- glyph borrow value cursor
    choose same cursor 0:
      choose less code 65:
        revise result <- dim
      otherwise:
        choose less code 91:
          revise result <- result
        otherwise:
          choose less code 97:
            revise result <- dim
          otherwise:
            choose less code 123:
              revise result <- result
            otherwise:
              revise result <- dim
    otherwise:
      choose same code 95:
        revise result <- result
      otherwise:
        choose less code 48:
          revise result <- dim
        otherwise:
          choose less code 58:
            revise result <- result
          otherwise:
            choose less code 65:
              revise result <- dim
            otherwise:
              choose less code 91:
                revise result <- result
              otherwise:
                choose less code 97:
                  revise result <- dim
                otherwise:
                  choose less code 123:
                    revise result <- result
                  otherwise:
                    revise result <- dim
    revise cursor <- sum cursor 1
  yield result

weave modules_safe_path [borrow value: Text] -> Truth:
  bind mutable result <- bright
  bind mutable length <- measure borrow value
  bind mutable stem_end <- 0
  bind mutable suffix <- ""
  bind mutable cursor <- 0
  bind mutable code <- 0
  bind mutable first <- 0
  bind mutable doubled <- -1
  bind mutable escaped <- -1
  choose less length 4:
    revise result <- dim
  otherwise:
    revise stem_end <- difference length 3
    revise suffix <- cut borrow value stem_end length
    choose same borrow suffix ".ae":
      revise result <- result
    otherwise:
      revise result <- dim
  choose result:
    revise first <- glyph borrow value 0
    choose same first 47:
      revise result <- dim
    otherwise:
      revise result <- result
    revise doubled <- seek borrow value "//" 0
    choose same doubled -1:
      revise result <- result
    otherwise:
      revise result <- dim
    revise escaped <- seek borrow value "../" 0
    choose same escaped -1:
      revise result <- result
    otherwise:
      revise result <- dim
    revise escaped <- seek borrow value "/../" 0
    choose same escaped -1:
      revise result <- result
    otherwise:
      revise result <- dim
    revise escaped <- seek borrow value "./" 0
    choose same escaped 0:
      revise result <- dim
    otherwise:
      revise result <- result
    revise escaped <- seek borrow value "/./" 0
    choose same escaped -1:
      revise result <- result
    otherwise:
      revise result <- dim
  otherwise:
    revise result <- result
  while less cursor length:
    revise code <- glyph borrow value cursor
    choose same code 47:
      revise result <- result
    otherwise:
      choose same code 45:
        revise result <- result
      otherwise:
        choose same code 46:
          revise result <- result
        otherwise:
          choose same code 95:
            revise result <- result
          otherwise:
            choose less code 48:
              revise result <- dim
            otherwise:
              choose less code 58:
                revise result <- result
              otherwise:
                choose less code 65:
                  revise result <- dim
                otherwise:
                  choose less code 91:
                    revise result <- result
                  otherwise:
                    choose less code 97:
                      revise result <- dim
                    otherwise:
                      choose less code 123:
                        revise result <- result
                      otherwise:
                        revise result <- dim
    revise cursor <- sum cursor 1
  yield result

weave modules_safe_key [borrow value: Text] -> Truth:
  bind mutable result <- dim
  bind mutable separator <- seek borrow value "::" 0
  bind mutable repeated <- -1
  bind mutable length <- measure borrow value
  bind mutable package <- ""
  bind mutable path <- ""
  bind mutable after_separator <- 0
  bind mutable package_valid <- dim
  bind mutable path_valid <- dim
  choose same separator -1:
    revise result <- call modules_safe_path borrow value
  otherwise:
    revise after_separator <- sum separator 2
    revise repeated <- seek borrow value "::" after_separator
    choose same repeated -1:
      revise package <- cut borrow value 0 separator
      revise path <- cut borrow value after_separator length
      revise package_valid <- call modules_safe_package borrow package
      revise path_valid <- call modules_safe_path borrow path
      choose package_valid:
        choose path_valid:
          revise result <- bright
        otherwise:
          revise result <- dim
      otherwise:
        revise result <- dim
    otherwise:
      revise result <- dim
  yield result

weave modules_decimal [borrow value: Text] -> Truth:
  bind mutable result <- bright
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable code <- 0
  choose same length 0:
    revise result <- dim
  otherwise:
    choose less length 7:
      revise result <- result
    otherwise:
      revise result <- dim
  while less cursor length:
    revise code <- glyph borrow value cursor
    choose less code 48:
      revise result <- dim
    otherwise:
      choose less code 58:
        revise result <- result
      otherwise:
        revise result <- dim
    revise cursor <- sum cursor 1
  yield result

weave modules_line_after [borrow value: Text, start: Whole] -> Whole:
  bind mutable output <- -1
  bind mutable line_end <- seek borrow value "\n" start
  choose same line_end -1:
    revise output <- -1
  otherwise:
    revise output <- sum line_end 1
  yield output

weave modules_line [borrow value: Text, start: Whole] -> Text:
  bind mutable output <- "!"
  bind mutable line_end <- seek borrow value "\n" start
  choose same line_end -1:
    revise output <- "!"
  otherwise:
    revise output <- cut borrow value start line_end
  yield move output

weave modules_catalog_entry [borrow catalog: Text] -> Text:
  bind mutable output <- "!"
  bind mutable magic_end <- seek borrow catalog "\n" 0
  bind mutable entry_start <- 0
  bind mutable entry_line <- ""
  bind mutable prefix <- "entry "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable entry_length <- 0
  bind mutable prefix_at <- -1
  choose same magic_end -1:
    revise output <- "!"
  otherwise:
    revise entry_start <- sum magic_end 1
    revise entry_line <- call modules_line borrow catalog entry_start
    revise entry_length <- measure borrow entry_line
    choose same borrow entry_line "!":
      revise output <- "!"
    otherwise:
      revise prefix_at <- seek borrow entry_line borrow prefix 0
      choose same prefix_at 0:
        choose less prefix_length entry_length:
          revise output <- cut borrow entry_line prefix_length entry_length
        otherwise:
          revise output <- "!"
      otherwise:
        revise output <- "!"
  yield move output

weave modules_catalog_package_count [borrow catalog: Text] -> Whole:
  bind mutable output <- -1
  bind mutable magic_end <- seek borrow catalog "\n" 0
  bind mutable entry_start <- 0
  bind mutable packages_start <- 0
  bind mutable line <- ""
  bind mutable prefix <- "packages "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable line_length <- 0
  bind mutable count_text <- ""
  bind mutable valid <- dim
  bind mutable prefix_at <- -1
  choose same magic_end -1:
    revise output <- -1
  otherwise:
    revise entry_start <- sum magic_end 1
    revise packages_start <- call modules_line_after borrow catalog entry_start
    choose same packages_start -1:
      revise output <- -1
    otherwise:
      revise line <- call modules_line borrow catalog packages_start
      revise line_length <- measure borrow line
      choose same borrow line "!":
        revise valid <- dim
      otherwise:
        revise prefix_at <- seek borrow line borrow prefix 0
        choose same prefix_at 0:
          choose less prefix_length line_length:
            revise count_text <- cut borrow line prefix_length line_length
            revise valid <- call modules_decimal borrow count_text
          otherwise:
            revise valid <- dim
        otherwise:
          revise valid <- dim
      choose valid:
        revise output <- number borrow count_text
        choose less 64 output:
          revise output <- -1
        otherwise:
          revise output <- output
      otherwise:
        revise output <- -1
  yield output

weave modules_catalog_packages_start [borrow catalog: Text] -> Whole:
  bind mutable output <- -1
  bind mutable magic_end <- seek borrow catalog "\n" 0
  bind mutable entry_start <- 0
  bind mutable packages_start <- 0
  choose same magic_end -1:
    revise output <- -1
  otherwise:
    revise entry_start <- sum magic_end 1
    revise packages_start <- call modules_line_after borrow catalog entry_start
    choose same packages_start -1:
      revise output <- -1
    otherwise:
      revise output <- call modules_line_after borrow catalog packages_start
  yield output

weave modules_catalog_units_line_start [borrow catalog: Text] -> Whole:
  bind mutable output <- -1
  bind mutable cursor <- call modules_catalog_packages_start borrow catalog
  bind mutable count <- call modules_catalog_package_count borrow catalog
  bind mutable index <- 0
  choose less -1 cursor:
    choose less -1 count:
      while less index count:
        revise cursor <- call modules_line_after borrow catalog cursor
        revise index <- sum index 1
      revise output <- cursor
    otherwise:
      revise output <- -1
  otherwise:
    revise output <- -1
  yield output

weave modules_catalog_unit_count [borrow catalog: Text] -> Whole:
  bind mutable output <- -1
  bind mutable units_start <- call modules_catalog_units_line_start borrow catalog
  bind mutable line <- ""
  bind mutable prefix <- "units "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable line_length <- 0
  bind mutable count_text <- ""
  bind mutable valid <- dim
  bind mutable prefix_at <- -1
  choose less -1 units_start:
    revise line <- call modules_line borrow catalog units_start
    revise line_length <- measure borrow line
    choose same borrow line "!":
      revise valid <- dim
    otherwise:
      revise prefix_at <- seek borrow line borrow prefix 0
      choose same prefix_at 0:
        choose less prefix_length line_length:
          revise count_text <- cut borrow line prefix_length line_length
          revise valid <- call modules_decimal borrow count_text
        otherwise:
          revise valid <- dim
      otherwise:
        revise valid <- dim
    choose valid:
      revise output <- number borrow count_text
      choose less 256 output:
        revise output <- -1
      otherwise:
        revise output <- output
    otherwise:
      revise output <- -1
  otherwise:
    revise output <- -1
  yield output

weave modules_catalog_headers_start [borrow catalog: Text] -> Whole:
  bind mutable output <- -1
  bind mutable units_start <- call modules_catalog_units_line_start borrow catalog
  choose less -1 units_start:
    revise output <- call modules_line_after borrow catalog units_start
  otherwise:
    revise output <- -1
  yield output

weave modules_catalog_payload_start [borrow catalog: Text] -> Whole:
  bind mutable output <- -1
  bind mutable cursor <- call modules_catalog_headers_start borrow catalog
  bind mutable count <- call modules_catalog_unit_count borrow catalog
  bind mutable index <- 0
  bind mutable marker <- ""
  choose less -1 cursor:
    choose less -1 count:
      while less index count:
        revise cursor <- call modules_line_after borrow catalog cursor
        revise index <- sum index 1
      choose less -1 cursor:
        revise marker <- call modules_line borrow catalog cursor
        choose same borrow marker "source":
          revise output <- call modules_line_after borrow catalog cursor
        otherwise:
          revise output <- -1
      otherwise:
        revise output <- -1
    otherwise:
      revise output <- -1
  otherwise:
    revise output <- -1
  yield output

weave modules_header_key [borrow header: Text] -> Text:
  bind mutable output <- "!"
  bind mutable prefix <- "unit "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable header_length <- measure borrow header
  bind mutable first_space <- -1
  bind mutable prefix_at <- -1
  revise prefix_at <- seek borrow header borrow prefix 0
  choose same prefix_at 0:
    revise first_space <- seek borrow header " " prefix_length
    choose less prefix_length first_space:
      revise output <- cut borrow header prefix_length first_space
    otherwise:
      revise output <- "!"
  otherwise:
    revise output <- "!"
  yield move output

weave modules_header_role [borrow header: Text] -> Text:
  bind mutable output <- "!"
  bind mutable prefix <- "unit "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable first_space <- -1
  bind mutable second_space <- -1
  bind mutable role_start <- 0
  bind mutable prefix_at <- -1
  revise prefix_at <- seek borrow header borrow prefix 0
  choose same prefix_at 0:
    revise first_space <- seek borrow header " " prefix_length
    choose less prefix_length first_space:
      revise role_start <- sum first_space 1
      revise second_space <- seek borrow header " " role_start
      choose less role_start second_space:
        revise output <- cut borrow header role_start second_space
      otherwise:
        revise output <- "!"
    otherwise:
      revise output <- "!"
  otherwise:
    revise output <- "!"
  yield move output

weave modules_header_count [borrow header: Text] -> Text:
  bind mutable output <- "!"
  bind mutable prefix <- "unit "
  bind mutable prefix_length <- measure borrow prefix
  bind mutable header_length <- measure borrow header
  bind mutable first_space <- -1
  bind mutable second_space <- -1
  bind mutable count_start <- 0
  bind mutable prefix_at <- -1
  revise prefix_at <- seek borrow header borrow prefix 0
  choose same prefix_at 0:
    revise first_space <- seek borrow header " " prefix_length

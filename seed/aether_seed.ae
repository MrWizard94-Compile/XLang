weave compile_bundle [borrow bundle: Text] -> Bytes:
  bind mutable output <- bytes ""
  bind elaborated <- call bundle_elaborate borrow bundle
  bind first <- glyph borrow elaborated 0
  bind mutable failed <- same first 33
  choose failed:
    speak "AETHER_SEED_ERROR:{\"schema\":\"aether.seed-error/v1\",\"code\":\"AE-SEED-016\",\"message\":\"seed bundle profile rejected\",\"line\":1,\"column\":1,\"origin\":\"seed-speak\"}"
  otherwise:
    revise output <- call compile borrow elaborated
  yield move output

weave main [] -> Whole:
  yield 0

weave bundle_ascii_lf [borrow value: Text] -> Truth:
  bind mutable result <- bright
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable code <- 0
  while less cursor length:
    revise code <- glyph borrow value cursor
    choose same code 10:
      revise result <- result
    otherwise:
      choose less code 32:
        revise result <- dim
      otherwise:
        choose less code 127:
          revise result <- result
        otherwise:
          revise result <- dim
    revise cursor <- sum cursor 1
  yield result

weave bundle_safe_identifier [borrow value: Text] -> Truth:
  bind mutable result <- bright
  bind mutable length <- measure borrow value
  bind mutable cursor <- 0
  bind mutable code <- 0
  choose same length 0:
    revise result <- dim
  otherwise:
    revise cursor <- 0
  while less cursor length:
    revise code <- glyph borrow value cursor
    choose same cursor 0:
      choose less code 97:
        revise result <- dim
      otherwise:
        choose less code 123:
          revise result <- result
        otherwise:
          revise result <- dim
    otherwise:
      choose same code 95:
        revise result <- result
      otherwise:
        choose less code 48:
          choose less code 97:
            revise result <- dim
          otherwise:
            choose less code 123:
              revise result <- result
            otherwise:
              revise result <- dim
        otherwise:
          choose less code 58:
            revise result <- result
          otherwise:
            choose less code 97:
              revise result <- dim
            otherwise:
              choose less code 123:
                revise result <- result
              otherwise:
                revise result <- dim
    revise cursor <- sum cursor 1
  yield result

weave bundle_safe_path [borrow value: Text] -> Truth:
  bind mutable result <- bright
  bind mutable length <- measure borrow value
  bind mutable stem_end <- 0
  bind mutable last_index <- 0
  bind mutable first_code <- 0
  bind mutable last_code <- 0
  bind mutable suffix <- ""
  bind mutable doubled <- -1
  bind mutable cursor <- 0
  bind mutable code <- 0
  choose less length 4:
    revise result <- dim
  otherwise:
    revise stem_end <- difference length 3
    revise suffix <- cut borrow value stem_end length
    choose same borrow suffix ".ae":
      revise result <- result
    otherwise:
      revise result <- dim
  choose result:
    revise first_code <- glyph borrow value 0
    revise last_index <- difference stem_end 1
    revise last_code <- glyph borrow value last_index
    revise doubled <- seek borrow value "//" 0
    choose same first_code 47:
      revise result <- dim
    otherwise:
      choose same last_code 47:
        revise result <- dim
      otherwise:
        choose same doubled -1:
          revise result <- result
        otherwise:
          revise result <- dim
  otherwise:
    revise cursor <- cursor
  while less cursor stem_end:
    revise code <- glyph borrow value cursor
    choose same code 47:
      revise result <- result
    otherwise:
      choose same code 95:
        revise result <- result
      otherwise:
        choose less code 48:
          choose less code 97:
            revise result <- dim
          otherwise:
            choose less code 123:
              revise result <- result
            otherwise:
              revise result <- dim
        otherwise:
          choose less code 58:
            revise result <- result
          otherwise:
            choose less code 97:
              revise result <- dim
            otherwise:
              choose less code 123:
                revise result <- result
              otherwise:
                revise result <- dim
    revise cursor <- sum cursor 1
  yield result

weave bundle_decimal_1to5 [borrow value: Text] -> Truth:
  bind mutable result <- bright

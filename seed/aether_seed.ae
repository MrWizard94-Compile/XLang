  bind mutable count <- call modules_decl_count borrow source
  bind mutable body <- call modules_body borrow source
  bind mutable length <- measure borrow body
  bind mutable cursor <- 0
  bind mutable line_end <- -1
  bind mutable next <- 0
  bind mutable line <- ""
  bind mutable content <- ""
  bind mutable content_length <- 0
  bind mutable starts_space <- dim
  bind mutable export_prefix <- "export weave "
  bind mutable weave_prefix <- "weave "
  bind mutable export_length <- measure borrow export_prefix
  bind mutable weave_length <- measure borrow weave_prefix
  bind mutable export_at <- -1
  bind mutable weave_at <- -1
  bind mutable tail <- ""
  bind mutable name <- ""
  bind mutable index <- 0
  choose less -1 count:
    choose less wanted count:
      while less cursor length:
        revise line_end <- seek borrow body "\n" cursor
        choose same line_end -1:
          revise line_end <- length
          revise next <- length
        otherwise:
          revise next <- sum line_end 1
        revise line <- cut borrow body cursor line_end
        revise starts_space <- call modules_line_starts_space borrow line
        choose starts_space:
          revise cursor <- next
        otherwise:
          revise content <- call modules_trim_start borrow line
          revise content_length <- measure borrow content
          revise export_at <- seek borrow content borrow export_prefix 0
          revise weave_at <- seek borrow content borrow weave_prefix 0
          choose same export_at 0:
            revise tail <- cut borrow content export_length content_length
            revise name <- call modules_weave_name borrow tail
            choose same index wanted:
              revise output <- borrow name
              revise cursor <- length
            otherwise:
              revise index <- sum index 1
              revise cursor <- next
          otherwise:
            choose same weave_at 0:
              revise tail <- cut borrow content weave_length content_length
              revise name <- call modules_weave_name borrow tail
              choose same index wanted:
                revise output <- borrow name
                revise cursor <- length
              otherwise:
                revise index <- sum index 1
                revise cursor <- next
            otherwise:
              revise cursor <- next
    otherwise:
      revise output <- "!"
  otherwise:
    revise output <- "!"
  yield move output

weave modules_decl_exported_at [borrow source: Text, wanted: Whole] -> Truth:
  bind mutable output <- dim
  bind mutable count <- call modules_decl_count borrow source
  bind mutable body <- call modules_body borrow source
  bind mutable length <- measure borrow body
  bind mutable cursor <- 0
  bind mutable line_end <- -1
  bind mutable next <- 0
  bind mutable line <- ""
  bind mutable content <- ""
  bind mutable starts_space <- dim
  bind mutable export_prefix <- "export weave "
  bind mutable weave_prefix <- "weave "
  bind mutable export_length <- measure borrow export_prefix
  bind mutable weave_length <- measure borrow weave_prefix
  bind mutable export_at <- -1
  bind mutable weave_at <- -1
  bind mutable index <- 0
  choose less -1 count:
    choose less wanted count:
      while less cursor length:
        revise line_end <- seek borrow body "\n" cursor
        choose same line_end -1:
          revise line_end <- length
          revise next <- length
        otherwise:
          revise next <- sum line_end 1
        revise line <- cut borrow body cursor line_end
        revise starts_space <- call modules_line_starts_space borrow line
        choose starts_space:
          revise cursor <- next
        otherwise:
          revise content <- call modules_trim_start borrow line
          revise export_at <- seek borrow content borrow export_prefix 0
          revise weave_at <- seek borrow content borrow weave_prefix 0
          choose same export_at 0:
            choose same index wanted:
              revise output <- bright
              revise cursor <- length
            otherwise:
              revise index <- sum index 1
              revise cursor <- next
          otherwise:
            choose same weave_at 0:
              choose same index wanted:
                revise output <- dim
                revise cursor <- length
              otherwise:
                revise index <- sum index 1
                revise cursor <- next
            otherwise:
              revise cursor <- next
    otherwise:
      revise output <- dim
  otherwise:
    revise output <- dim
  yield output

weave modules_has_decl [borrow source: Text, borrow wanted: Text] -> Truth:
  bind mutable result <- dim
  bind mutable count <- call modules_decl_count borrow source
  bind mutable index <- 0
  bind mutable name <- ""
  choose less -1 count:
    while less index count:
      revise name <- call modules_decl_name_at borrow source index
      choose same borrow name borrow wanted:
        revise result <- bright
      otherwise:
        revise result <- result
      revise index <- sum index 1
  otherwise:
    revise result <- dim
  yield result

weave modules_lib_forbidden [borrow source: Text] -> Truth:
  bind mutable result <- dim
  bind mutable body <- call modules_body borrow source
  bind mutable length <- measure borrow body
  bind mutable cursor <- 0
  bind mutable line_end <- -1
  bind mutable next <- 0
  bind mutable line <- ""
  bind mutable content <- ""
  bind mutable starts_space <- dim
  bind mutable record_at <- -1
  bind mutable shape_at <- -1
  bind mutable host_at <- -1
  while less cursor length:
    revise line_end <- seek borrow body "\n" cursor
    choose same line_end -1:
      revise line_end <- length
      revise next <- length
    otherwise:
      revise next <- sum line_end 1
    revise line <- cut borrow body cursor line_end
    revise starts_space <- call modules_line_starts_space borrow line
    choose starts_space:
      revise result <- result
    otherwise:
      revise content <- call modules_trim_start borrow line
      revise record_at <- seek borrow content "record " 0
      revise shape_at <- seek borrow content "shape " 0
      revise host_at <- seek borrow content "host " 0
      choose same record_at 0:
        revise result <- bright
      otherwise:
        choose same shape_at 0:
          revise result <- bright
        otherwise:
          choose same host_at 0:
            revise result <- bright
          otherwise:
            revise result <- result
    revise cursor <- next
  yield result

weave modules_unit_valid [borrow source: Text, borrow role: Text] -> Truth:
  bind mutable result <- bright
  bind mutable world_name <- call modules_world borrow source
  bind mutable imports <- call modules_import_count borrow source
  bind mutable declarations <- call modules_decl_count borrow source
  bind mutable index <- 0
  bind mutable name <- ""
  bind mutable names <- ""
  bind mutable duplicate <- dim
  bind mutable has_main <- dim
  bind mutable forbidden <- dim
  bind mutable role_valid <- call modules_role_valid borrow role
  choose same borrow world_name "!":
    revise result <- dim
  otherwise:
    revise result <- result
  choose less -1 imports:
    choose less 256 imports:
      revise result <- dim
    otherwise:
      revise result <- result
  otherwise:
    revise result <- dim
  choose less -1 declarations:
    revise result <- result
  otherwise:
    revise result <- dim
  choose role_valid:
    revise result <- result
  otherwise:
    revise result <- dim
  while less index declarations:
    revise name <- call modules_decl_name_at borrow source index
    revise duplicate <- call modules_set_contains borrow names borrow name
    choose duplicate:
      revise result <- dim
    otherwise:
      revise names <- call modules_set_add borrow names borrow name
    choose same borrow name "main":
      revise has_main <- bright
    otherwise:
      revise has_main <- has_main
    revise index <- sum index 1
  choose same borrow role "main":
    choose has_main:
      revise result <- result
    otherwise:
      revise result <- dim
  otherwise:
    choose same borrow role "test":
      choose has_main:
        revise result <- result
      otherwise:
        revise result <- dim
    otherwise:
      choose same borrow role "lib":
        choose has_main:
          revise result <- dim
        otherwise:
          revise forbidden <- call modules_lib_forbidden borrow source
          choose forbidden:
            revise result <- dim
          otherwise:
            revise result <- result
      otherwise:
        revise result <- dim
  yield result

weave modules_target_allowed [borrow catalog: Text, borrow key: Text] -> Truth:
  bind mutable result <- dim
  bind mutable package <- call modules_key_package borrow key
  choose same borrow package "":
    revise result <- bright
  otherwise:
    revise result <- call modules_catalog_has_package borrow catalog borrow package
  yield result

weave modules_rewrite_local_call [borrow value: Text, borrow from: Text, borrow to: Text] -> Text:
  bind mutable output <- ""
  bind mutable length <- measure borrow value
  bind mutable from_length <- measure borrow from
  bind mutable cursor <- 0
  bind mutable found <- -1
  bind mutable prefix <- ""
  bind mutable call_prefix <- "call "
  bind mutable call_length <- measure borrow call_prefix
  bind mutable target_start <- 0
  bind mutable target_end <- 0
  bind mutable scan <- 0
  bind mutable code <- 0
  bind mutable ended <- dim
  bind mutable target <- ""
  bind mutable valid <- bright
  choose same from_length 0:
    revise valid <- dim
  otherwise:
    revise valid <- valid
  while less cursor length:
    choose valid:
      revise found <- seek borrow value borrow call_prefix cursor
      choose same found -1:
        revise prefix <- cut borrow value cursor length
        revise output <- join borrow output borrow prefix
        revise cursor <- length
      otherwise:
        revise prefix <- cut borrow value cursor found
        revise output <- join borrow output borrow prefix
        revise target_start <- sum found call_length
        revise target_end <- target_start
        revise scan <- target_start
        revise ended <- dim
        while less scan length:
          choose ended:
            revise scan <- length
          otherwise:
            revise code <- glyph borrow value scan
            choose same code 32:
              revise target_end <- scan
              revise ended <- bright
              revise scan <- length
            otherwise:
              choose same code 10:
                revise target_end <- scan
                revise ended <- bright
                revise scan <- length
              otherwise:
                choose same code 13:
                  revise target_end <- scan
                  revise ended <- bright
                  revise scan <- length
                otherwise:
                  revise scan <- sum scan 1
        choose ended:
          revise target_end <- target_end
        otherwise:
          revise target_end <- length
        choose same target_start target_end:
          revise valid <- dim
          revise cursor <- length
        otherwise:
          revise target <- cut borrow value target_start target_end
          revise output <- join borrow output borrow call_prefix
          choose same borrow target borrow from:
            revise output <- join borrow output borrow to
          otherwise:
            revise output <- join borrow output borrow target
          revise cursor <- target_end
    otherwise:
      revise cursor <- length
  choose valid:
    revise output <- borrow output
  otherwise:
    revise output <- "!"
  yield move output

weave modules_transform [borrow catalog: Text, borrow key: Text] -> Text:
  bind mutable output <- "!"
  bind mutable source <- call modules_catalog_source borrow catalog borrow key
  bind mutable body <- ""
  bind mutable declarations <- 0
  bind mutable declaration_index <- 0
  bind mutable name <- ""
  bind mutable mangled <- ""
  bind mutable declaration_pattern <- ""
  bind mutable declaration_replacement <- ""
  bind mutable imports <- 0
  bind mutable import_index <- 0
  bind mutable target <- ""
  bind mutable alias <- ""
  bind mutable aliases <- ""
  bind mutable alias_duplicate <- dim
  bind mutable target_allowed <- dim
  bind mutable target_role <- ""
  bind mutable target_source <- ""
  bind mutable target_declarations <- 0
  bind mutable target_index <- 0
  bind mutable exported <- dim
  bind mutable target_name <- ""
  bind mutable target_mangled <- ""
  bind mutable qualified <- ""
  bind mutable call_pattern <- ""
  bind mutable call_replacement <- ""
  bind mutable unresolved <- ""
  bind mutable unresolved_at <- -1
  bind mutable valid <- bright
  choose same borrow source "!":
    revise valid <- dim
  otherwise:
    revise body <- call modules_body borrow source
    choose same borrow body "!":
      revise valid <- dim
    otherwise:
      revise declarations <- call modules_decl_count borrow source
      revise imports <- call modules_import_count borrow source
      choose less -1 declarations:
        revise valid <- valid
      otherwise:
        revise valid <- dim
      choose less -1 imports:
        revise valid <- valid
      otherwise:
        revise valid <- dim
  choose valid:
    revise body <- call modules_replace_all borrow body "export weave " "weave "
  otherwise:
    revise body <- "!"
  while less declaration_index declarations:
    revise name <- call modules_decl_name_at borrow source declaration_index
    choose same borrow name "main":
      revise mangled <- "main"
    otherwise:
      revise mangled <- call modules_mangle borrow key borrow name
    revise declaration_pattern <- "weave "
    revise declaration_pattern <- join borrow declaration_pattern borrow name
    revise declaration_pattern <- join borrow declaration_pattern " ["
    revise declaration_replacement <- "weave "
    revise declaration_replacement <- join borrow declaration_replacement borrow mangled
    revise declaration_replacement <- join borrow declaration_replacement " ["
    revise body <- call modules_replace_all borrow body borrow declaration_pattern borrow declaration_replacement
    choose same borrow body "!":
      revise valid <- dim
    otherwise:
      revise valid <- valid
    revise declaration_index <- sum declaration_index 1
  while less import_index imports:
    revise target_declarations <- 0
    revise target_source <- ""
    revise target <- call modules_import_target_at borrow source import_index
    revise alias <- call modules_import_alias_at borrow source import_index
    revise alias_duplicate <- call modules_set_contains borrow aliases borrow alias
    choose same borrow target "!":
      revise valid <- dim
    otherwise:
      choose same borrow alias "!":
        revise valid <- dim
      otherwise:
        choose alias_duplicate:
          revise valid <- dim
        otherwise:
          revise aliases <- call modules_set_add borrow aliases borrow alias
    revise target_allowed <- call modules_target_allowed borrow catalog borrow target
    choose target_allowed:
      revise target_role <- call modules_catalog_role borrow catalog borrow target
      choose same borrow target_role "lib":
        revise target_source <- call modules_catalog_source borrow catalog borrow target
        choose same borrow target_source "!":
          revise valid <- dim
        otherwise:
          revise target_declarations <- call modules_decl_count borrow target_source
          choose less -1 target_declarations:
            revise valid <- valid
          otherwise:
            revise valid <- dim
      otherwise:
        revise valid <- dim
    otherwise:
      revise valid <- dim
    revise target_index <- 0
    while less target_index target_declarations:
      revise exported <- call modules_decl_exported_at borrow target_source target_index
      choose exported:
        revise target_name <- call modules_decl_name_at borrow target_source target_index
        revise target_mangled <- call modules_mangle borrow target borrow target_name
        revise qualified <- join borrow alias "."
        revise qualified <- join borrow qualified borrow target_name
        revise call_pattern <- "call "
        revise call_pattern <- join borrow call_pattern borrow qualified
        revise call_replacement <- "call "
        revise call_replacement <- join borrow call_replacement borrow target_mangled
        revise body <- call modules_replace_all borrow body borrow call_pattern borrow call_replacement
        choose same borrow body "!":
          revise valid <- dim
        otherwise:
          revise valid <- valid
      otherwise:
        revise valid <- valid
      revise target_index <- sum target_index 1
    revise unresolved <- "call "
    revise unresolved <- join borrow unresolved borrow alias
    revise unresolved <- join borrow unresolved "."
    revise unresolved_at <- seek borrow body borrow unresolved 0
    choose same unresolved_at -1:
      revise valid <- valid
    otherwise:
      revise valid <- dim
    revise import_index <- sum import_index 1
  revise declaration_index <- 0
  while less declaration_index declarations:
    revise name <- call modules_decl_name_at borrow source declaration_index
    choose same borrow name "main":
      revise mangled <- "main"
    otherwise:
      revise mangled <- call modules_mangle borrow key borrow name
    choose same borrow name borrow mangled:
      revise body <- borrow body
    otherwise:
      revise body <- call modules_rewrite_local_call borrow body borrow name borrow mangled
      choose same borrow body "!":
        revise valid <- dim
      otherwise:
        revise valid <- valid
    revise declaration_index <- sum declaration_index 1
  choose valid:
    revise output <- call modules_trim_end borrow body
  otherwise:
    revise output <- "!"
  yield move output

weave modules_graph_order [borrow catalog: Text] -> Text:
  bind mutable output <- "!"
  bind mutable valid <- call modules_catalog_valid borrow catalog
  bind mutable entry <- call modules_catalog_entry borrow catalog
  bind mutable stack <- ""
  bind mutable stack_length <- 0
  bind mutable visiting <- ""
  bind mutable visited <- ""
  bind mutable order <- ""
  bind mutable processed <- ""
  bind mutable active <- ""
  bind mutable source <- ""
  bind mutable role <- ""
  bind mutable unit_valid <- dim
  bind mutable imports <- 0
  bind mutable import_index <- 0
  bind mutable candidate <- ""
  bind mutable selected <- ""
  bind mutable selected_found <- dim
  bind mutable edge <- ""
  bind mutable edge_seen <- dim
  bind mutable target_allowed <- dim
  bind mutable target_role <- ""
  bind mutable target_source <- ""
  bind mutable target_valid <- dim
  bind mutable visiting_hit <- dim
  bind mutable visited_hit <- dim
  bind mutable steps <- 0
  bind mutable exhausted <- dim
  choose valid:
    revise stack <- call modules_set_add borrow stack borrow entry
    revise visiting <- call modules_set_add borrow visiting borrow entry
    revise stack_length <- call modules_set_count borrow stack
  otherwise:
    revise stack <- ""
    revise stack_length <- 0
  while less 0 stack_length:
    revise steps <- sum steps 1
    choose less 66000 steps:
      revise exhausted <- bright
    otherwise:
      revise exhausted <- dim
    choose exhausted:
      revise valid <- dim
      revise stack <- ""
    otherwise:
      revise active <- call modules_set_last borrow stack
      revise source <- call modules_catalog_source borrow catalog borrow active
      revise role <- call modules_catalog_role borrow catalog borrow active
      revise unit_valid <- call modules_unit_valid borrow source borrow role
      choose unit_valid:
        revise imports <- call modules_import_count borrow source
        choose less -1 imports:
          revise valid <- valid
        otherwise:
          revise valid <- dim
          revise imports <- 0
      otherwise:
        revise valid <- dim
        revise imports <- 0
      revise import_index <- 0
      revise selected <- ""
      revise selected_found <- dim
      while less import_index imports:
        revise candidate <- call modules_import_target_at borrow source import_index
        choose selected_found:
          revise selected_found <- selected_found
        otherwise:
          choose same borrow candidate "!":
            revise valid <- dim
          otherwise:
            revise edge <- join borrow active ">"
            revise edge <- join borrow edge borrow candidate
            revise edge_seen <- call modules_set_contains borrow processed borrow edge
            choose edge_seen:
              revise edge_seen <- edge_seen
            otherwise:
              revise processed <- call modules_set_add borrow processed borrow edge
              revise selected <- borrow candidate
              revise selected_found <- bright
        revise import_index <- sum import_index 1
      choose selected_found:
        revise target_allowed <- call modules_target_allowed borrow catalog borrow selected
        revise target_role <- call modules_catalog_role borrow catalog borrow selected
        revise target_source <- call modules_catalog_source borrow catalog borrow selected
        revise target_valid <- call modules_unit_valid borrow target_source borrow target_role
        choose target_allowed:
          choose same borrow target_role "lib":
            choose target_valid:
              revise visiting_hit <- call modules_set_contains borrow visiting borrow selected
              choose visiting_hit:
                revise valid <- dim
                revise stack <- ""
              otherwise:
                revise visited_hit <- call modules_set_contains borrow visited borrow selected
                choose visited_hit:
                  revise stack <- borrow stack
                otherwise:
                  revise stack <- call modules_set_add borrow stack borrow selected
                  revise visiting <- call modules_set_add borrow visiting borrow selected
            otherwise:
              revise valid <- dim
              revise stack <- ""
          otherwise:
            revise valid <- dim
            revise stack <- ""
        otherwise:
          revise valid <- dim
          revise stack <- ""
      otherwise:
        revise stack <- call modules_set_remove borrow stack borrow active
        revise visiting <- call modules_set_remove borrow visiting borrow active
        revise visited_hit <- call modules_set_contains borrow visited borrow active
        choose visited_hit:
          revise visited <- borrow visited
        otherwise:
          revise visited <- call modules_set_add borrow visited borrow active
          revise order <- call modules_set_add borrow order borrow active
      revise stack_length <- call modules_set_count borrow stack
  choose valid:
    revise output <- borrow order
  otherwise:
    revise output <- "!"
  yield move output

weave modules_worlds_unique [borrow catalog: Text, borrow order: Text] -> Truth:
  bind mutable result <- bright
  bind mutable count <- call modules_set_count borrow order
  bind mutable index <- 0
  bind mutable key <- ""
  bind mutable source <- ""
  bind mutable world_name <- ""
  bind mutable worlds <- ""
  bind mutable duplicate <- dim
  while less index count:
    revise key <- call modules_set_nth borrow order index
    revise source <- call modules_catalog_source borrow catalog borrow key
    revise world_name <- call modules_world borrow source
    choose same borrow world_name "!":
      revise result <- dim
    otherwise:
      revise duplicate <- call modules_set_contains borrow worlds borrow world_name
      choose duplicate:
        revise result <- dim
      otherwise:
        revise worlds <- call modules_set_add borrow worlds borrow world_name
    revise index <- sum index 1
  yield result

weave modules_elaborate [borrow catalog: Text] -> Text:
  bind mutable output <- "!"
  bind mutable valid <- call modules_catalog_valid borrow catalog
  bind mutable entry <- call modules_catalog_entry borrow catalog
  bind mutable order <- ""
  bind mutable worlds_unique <- dim
  bind mutable entry_source <- ""
  bind mutable entry_world <- ""
  bind mutable combined <- ""
  bind mutable count <- 0
  bind mutable index <- 0
  bind mutable key <- ""
  bind mutable body <- ""
  bind mutable body_length <- 0
  choose valid:
    revise order <- call modules_graph_order borrow catalog
    choose same borrow order "!":
      revise valid <- dim
    otherwise:
      revise worlds_unique <- call modules_worlds_unique borrow catalog borrow order
      choose worlds_unique:
        revise entry_source <- call modules_catalog_source borrow catalog borrow entry
        revise entry_world <- call modules_world borrow entry_source
        choose same borrow entry_world "!":
          revise valid <- dim
        otherwise:
          revise combined <- "world "
          revise combined <- join borrow combined borrow entry_world
          revise combined <- join borrow combined "\n"
      otherwise:
        revise valid <- dim
  otherwise:
    revise valid <- dim
  revise count <- call modules_set_count borrow order
  while less index count:
    revise key <- call modules_set_nth borrow order index
    revise body <- call modules_transform borrow catalog borrow key
    choose same borrow body "!":
      revise valid <- dim
    otherwise:
      revise body_length <- measure borrow body
      choose less 0 body_length:
        revise combined <- join borrow combined "\n"
        revise combined <- join borrow combined borrow body
        revise combined <- join borrow combined "\n"
      otherwise:
        revise combined <- borrow combined
    revise index <- sum index 1
  choose valid:
    revise output <- borrow combined
  otherwise:
    revise output <- "!"
  yield move output

weave compile_bundle [borrow bundle: Text] -> Bytes:
  bind mutable output <- bytes ""
  bind mutable elaborated <- "!"
  bind mutable newline <- "\n"
  bind mutable magic_end <- seek borrow bundle borrow newline 0
  bind mutable magic <- ""
  choose less -1 magic_end:
    revise magic <- cut borrow bundle 0 magic_end
    choose same borrow magic "aether.seed-bundle/v1":
      revise elaborated <- call bundle_elaborate borrow bundle
    otherwise:
      choose same borrow magic "aether.seed-bundle/v2":
        revise elaborated <- call bundle_chain_elaborate borrow bundle
      otherwise:
        choose same borrow magic "aether.seed-bundle/v3":
          revise elaborated <- call bundle_fanin_elaborate borrow bundle
        otherwise:
          revise elaborated <- "!"
  otherwise:
    revise elaborated <- "!"
  bind first <- glyph borrow elaborated 0
  bind mutable failed <- same first 33
  choose failed:
    speak "AETHER_SEED_ERROR:{\"schema\":\"aether.seed-error/v1\",\"code\":\"AE-SEED-016\",\"message\":\"seed bundle profile rejected\",\"line\":1,\"column\":1,\"origin\":\"seed-speak\"}"
  otherwise:
    revise output <- call compile borrow elaborated
  yield move output

weave compile_modules [borrow catalog: Text] -> Bytes:
  bind mutable output <- bytes ""
  bind mutable catalog_valid <- call modules_catalog_valid borrow catalog
  bind mutable elaborated <- "!"
  choose catalog_valid:
    revise elaborated <- call modules_elaborate borrow catalog
  otherwise:
    revise elaborated <- "!"
  bind first <- glyph borrow elaborated 0
  bind mutable failed <- same first 33
  choose failed:
    choose catalog_valid:
      speak "AETHER_SEED_ERROR:{\"schema\":\"aether.seed-error/v1\",\"code\":\"AE-SEED-017\",\"message\":\"seed module graph rejected\",\"line\":1,\"column\":1,\"origin\":\"seed-speak\"}"
    otherwise:
      speak "AETHER_SEED_ERROR:{\"schema\":\"aether.seed-error/v1\",\"code\":\"AE-SEED-017\",\"message\":\"seed module catalog framing rejected\",\"line\":1,\"column\":1,\"origin\":\"seed-speak\"}"
  otherwise:
    revise output <- call compile borrow elaborated
  yield move output

weave main [] -> Whole:
  yield 0
